# AI provider: mock (default outside production, no key needed), muse, or openai-compatible
AI_PROVIDER=mock

# Meta Muse via the Meta Model API (OpenAI-compatible Chat Completions)
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
# MUSE_BASE_URL=https://api.meta.ai/v1

# Any other OpenAI-compatible endpoint
# AI_NAME=
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_VISION=false
# AI_JSON_SCHEMA=true
# AI_REASONING_EFFORT=false

# "contributor" models may train on owners' data; refused unless true
# AI_ALLOW_CONTRIBUTOR_MODELS=false

# Hosted Postgres in production; local PGlite in .pglite/ when unset
# DATABASE_URL=
