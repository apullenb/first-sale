# AI provider: mock (default outside production, no key needed), muse, or openai-compatible
AI_PROVIDER=mock

# Meta Muse via the Meta Model API: Chat Completions, plus the Responses API for web search
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
# MUSE_BASE_URL=https://api.meta.ai/v1
# Product photo editing (Muse Image, same key). Other providers have no photo editing.
MUSE_IMAGE_MODEL=muse-image-1.0

# Any other OpenAI-compatible endpoint
# AI_NAME=
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_VISION=false
# AI_JSON_SCHEMA=true
# AI_REASONING_EFFORT=false
# AI_PDF=false
# AI_WEB_SEARCH=false

# AI suggestions allowed per day across all owners (default 500)
# AI_DAILY_LIMIT=2000

# "contributor" models may train on owners' data; refused unless true
# AI_ALLOW_CONTRIBUTOR_MODELS=false

# Hosted Postgres in production; local PGlite in .pglite/ when unset
# DATABASE_URL=

# Accounts (Better Auth). Make a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Other addresses allowed to sign in, comma-separated (Vercel previews are added automatically)
# BETTER_AUTH_TRUSTED_ORIGINS=
